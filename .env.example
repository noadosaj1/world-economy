# ---------------------------------------------------------------------------
# World Economy - environment variables
# Copy to .env.local and fill in with your own Supabase project values.
# NEVER commit real keys. Only placeholder names belong in this file.
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. This key bypasses Row Level Security.
# It must NEVER appear in client-side code or in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phase 1 needs only the two NEXT_PUBLIC_* values above to run.
# SUPABASE_SERVICE_ROLE_KEY is read by src/lib/supabase/admin.ts, which nothing
# imports yet - it is here for the admin tooling in a later phase.
