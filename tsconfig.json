{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `tests` is excluded on purpose. `next build` type-checks everything in
  // `include`, and the tests import vitest - a devDependency. Leaving them in
  // makes a production build depend on test tooling, which fails on any host
  // that prunes devDependencies before building. Tests are type-checked by
  // tsconfig.test.json instead.
  "exclude": ["node_modules", "tests"]
}
